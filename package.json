{
  "name": "easy-apps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib/*.js": "./lib/*.ts",
    "#lib/*": "./lib/*.ts",
    "#apps-lib/*.js": "./apps-lib/*.ts",
    "#apps-lib/*": "./apps-lib/*.ts"
  },
  "scripts": {
    "dev": "nodemon -w src -w lib -x tsx src/main.ts",
    "mcp:inspect": "mcp-inspector",
    "start": "cross-env NODE_ENV=production tsx src/main.ts",
    "build": "vite build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcrypt": "^6.0.0",
    "cross-env": "^7.0.3",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite-express": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.15.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "nodemon": "^3.1.10",
    "sass": "^1.100.0",
    "vite": "^6.3.3"
  }
}
